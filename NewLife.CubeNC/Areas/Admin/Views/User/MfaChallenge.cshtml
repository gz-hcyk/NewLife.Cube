@model NewLife.Cube.Models.MfaChallengeModel
@using NewLife.Common
@{
    Layout = null;
    ViewBag.Title = ViewBag.Title ?? "二步验证";
    var res = CubeSetting.Current.ResourceUrl;
    if (res.IsNullOrEmpty()) res = "/Content";
    var returnUrl = ViewBag.ReturnUrl as String;
    var methods = Model?.Methods ?? Array.Empty<String>();
    var first = methods.FirstOrDefault() ?? "totp";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - @SysConfig.Current.DisplayName</title>
    <link href="@res/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@res/Cube.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(160deg, #1b3a5f 0%, #2a5f8f 45%, #3d7ea6 100%); min-height: 100vh; }
        .mfa-card { max-width: 400px; margin: 60px auto; background: #fff; border-radius: 12px; padding: 28px 24px; box-shadow: 0 16px 40px rgba(0,0,0,.18); }
        .mfa-card h2 { font-size: 20px; margin: 0 0 8px; text-align: center; }
        .mfa-card .sub { color: #5c6b76; font-size: 13px; text-align: center; margin-bottom: 16px; }
        .methods { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
        .methods label { flex: 1; min-width: 70px; text-align: center; border: 1px solid #d5dee6; border-radius: 8px; padding: 8px 4px; font-size: 12px; cursor: pointer; margin: 0; }
        .methods input { display: none; }
        .methods input:checked + span { color: #2f6fed; font-weight: 600; }
        .methods label:has(input:checked) { border-color: #2f6fed; background: #e8f0fe; }
        .otp { letter-spacing: 6px; text-align: center; font-size: 20px; }
        .hint { font-size: 12px; color: #5c6b76; margin-top: 8px; }
    </style>
</head>
<body>
<div class="mfa-card">
    <h2>二步验证</h2>
    <p class="sub">账号密码已通过@(String.IsNullOrEmpty(Model?.DisplayName) ? "" : "（" + Model.DisplayName + "）")，请完成第二因子</p>
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <form action="@Url.Action("VerifyMfa", "User", new { r = returnUrl })" method="post" id="mfa-form">
        <input type="hidden" name="MfaToken" value="@Model?.MfaToken" />
        <div class="methods">
            @foreach (var m in methods)
            {
                var text = m switch { "totp" => "验证器", "sms" => "短信", "mail" => "邮件", "backup" => "恢复码", _ => m };
                <label><input type="radio" name="Method" value="@m" @(m == first ? "checked" : "") /><span>@text</span></label>
            }
        </div>
        <div class="form-group">
            <input class="form-control otp" name="Code" maxlength="16" placeholder="验证码" autocomplete="one-time-code" required />
        </div>
        <p class="hint" id="mfa-hint">请输入第二因子验证码</p>
        <button type="submit" class="btn btn-primary btn-block" style="width:100%;margin-top:12px;">验证并登录</button>
        <button type="button" class="btn btn-link btn-block" id="btn-send" style="width:100%;">发送短信/邮件验证码</button>
        <a class="btn btn-link btn-block" href="@Url.Action("Login", "User", new { r = returnUrl })" style="width:100%;">返回登录</a>
    </form>
</div>
<script src="@res/jquery/jquery.min.js"></script>
<script>
(function () {
  var hints = { totp: '打开 Authenticator，输入 6 位动态码。', sms: '点击下方发送短信验证码。', mail: '点击下方发送邮件验证码。', backup: '输入绑定 MFA 时保存的一次性恢复码。' };
  function syncHint() {
    var m = $('input[name=Method]:checked').val();
    $('#mfa-hint').text(hints[m] || '请输入验证码');
    $('#btn-send').toggle(m === 'sms' || m === 'mail');
  }
  $('input[name=Method]').on('change', syncHint);
  syncHint();
  $('#btn-send').on('click', function () {
    $.post('@Url.Action("SendMfaCode", "User")', { MfaToken: $('input[name=MfaToken]').val(), Method: $('input[name=Method]:checked').val() })
      .done(function (res) { alert(res.msg || res.message || '已发送'); })
      .fail(function (xhr) { alert((xhr.responseJSON && (xhr.responseJSON.msg || xhr.responseJSON.message)) || '发送失败'); });
  });
})();
</script>
</body>
</html>
